{
  "name": "budget-wallet",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.19.0"
  },
  "scripts": {
    "dev:frontend": "vite --config frontend/vite.config.ts",
    "build:frontend": "vite build --config frontend/vite.config.ts",
    "typecheck:frontend": "tsc --project frontend/tsconfig.json --noEmit",
    "test": "node --test",
    "test:watch": "node --test --watch",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run typecheck:frontend && npm test",
    "db:validate": "prisma validate --config prisma.config.ts",
    "db:migrate": "prisma migrate dev --config prisma.config.ts",
    "db:deploy": "prisma migrate deploy --config prisma.config.ts",
    "db:status": "prisma migrate status --config prisma.config.ts"
  },
  "devDependencies": {
    "@playwright/cli": "^0.1.25",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "prisma": "7.10.1",
    "typescript": "7.0.2",
    "vite": "^8.3.8"
  },
  "allowScripts": {
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "better-sqlite3@12.11.1": true,
    "better-sqlite3@13.2.0": true,
    "bcrypt@6.0.0": true
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcrypt": "^6.0.0",
    "bcrypt-ts": "^9.0.3",
    "better-sqlite3": "^13.2.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
